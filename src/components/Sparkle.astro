---
// Destello de cuatro puntas con degradado. Decorativo.
interface Props {
  class?: string;
  id: string;
}
const { class: className, id } = Astro.props;
---

<svg class={className} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="6" y1="4" x2="42" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0" style="stop-color: color-mix(in oklab, var(--color-accent) 70%, var(--color-surface))"></stop>
      <stop offset="0.55" style="stop-color: var(--color-accent)"></stop>
      <stop offset="1" style="stop-color: color-mix(in oklab, var(--color-accent) 55%, var(--color-sky))"></stop>
    </linearGradient>
  </defs>
  <path
    d="M24 4Q28.6 19.4 44 24Q28.6 28.6 24 44Q19.4 28.6 4 24Q19.4 19.4 24 4Z"
    fill={`url(#${id})`}
    stroke={`url(#${id})`}
    stroke-width="3"
    stroke-linejoin="round"></path>
</svg>
