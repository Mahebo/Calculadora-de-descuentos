<section class="flex flex-col gap-3" aria-label="Historial">
  <h2 class="m-0 font-display text-[1.25rem] font-semibold">Historial</h2>
  <div class="flex flex-wrap gap-2.5">
    <input
      id="histName"
      class="field flex-[1_1_14rem]"
      type="text"
      placeholder="Nombre para esta lista (opcional)"
      aria-label="Nombre para guardar esta lista"
    />
    <button class="btn" id="histSave" type="button">Guardar en historial</button>
  </div>
  <p class="note" id="histNote">Se guarda solo en este navegador. Cargar una lista reemplaza la actual.</p>
  <div class="sheet flex flex-col" id="histList"></div>
</section>

<template id="hist-tpl">
  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-3.5 py-3 not-first:border-t not-first:border-line"
  >
    <div class="min-w-0 flex-[1_1_16rem]">
      <div data-h="name" class="font-semibold wrap-anywhere"></div>
      <div data-h="meta" class="text-[.85rem] text-muted tabular-nums"></div>
    </div>
    <div class="flex gap-2">
      <button type="button" data-h="load" class="btn btn-ghost btn-small">Cargar</button>
      <button type="button" data-h="del" class="btn btn-ghost btn-small">Eliminar</button>
    </div>
  </div>
</template>
