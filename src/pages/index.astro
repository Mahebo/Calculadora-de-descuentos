---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ItemsTable from '../components/ItemsTable.astro';
import Results from '../components/Results.astro';
import History from '../components/History.astro';
import { summarize } from '../lib/calc';
import { exampleState } from '../lib/storage';
import { dict } from '../i18n';
import { ORIGINS } from '../lib/site';

// Se genera en cada petición: el idioma depende del navegador o del selector (src/middleware.ts).
export const prerender = false;

const t = dict(Astro.locals.lang);
// Metadatos (JSON-LD) en el idioma del dominio, como el resto del SEO (ver Base.astro).
const seo = dict(Astro.locals.seoLang);
const origin = ORIGINS[Astro.locals.seoLang];

// Estado inicial (filas de ejemplo) renderizado en el servidor: lo ven los buscadores y la página no
// salta al cargar. El script lo vuelve a dibujar con lo guardado en el navegador, si hay algo.
const initial = exampleState(t.table.examples);
const totals = summarize(initial.items, initial.pct);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: seo.seo.ogTitle,
  url: origin + '/',
  description: seo.seo.description,
  image: new URL(seo.seo.image, origin).href,
  inLanguage: seo.lang,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  browserRequirements: seo.seo.browserRequirements,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: seo.seo.priceCurrency },
  author: { '@type': 'Person', name: 'Mauro Hernández', url: 'https://mahebo.com' },
  publisher: { '@type': 'Organization', name: 'Mahebo', url: 'https://mahebo.com' },
};
---

<Base>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main
    class="mx-auto grid max-w-[860px] gap-6 lg:max-w-[1120px] lg:grid-cols-[minmax(0,1fr)_21rem] lg:gap-x-7"
  >
    <Header />
    <ItemsTable items={initial.items} pct={initial.pct} totals={totals} examples={initial.examples} />
    <Results totals={totals} pct={initial.pct} />
    <History />
  </main>
</Base>

<script>
  import {
    clampPct,
    isActive,
    itemDiscounted,
    itemTotal,
    MAX_PCT,
    money,
    num,
    pdfFilename,
    summarize,
    type Item,
  } from '../lib/calc';
  import { loadHistory, loadState, saveHistory, saveState } from '../lib/storage';
  import { buildPdf, downloadPdf, loadJsPDF } from '../lib/pdf';
  import { emptyState as emptyStateClass } from '../lib/ui';
  import { track, trackFirstUse } from '../lib/analytics';
  import { dict } from '../i18n';

  // Mismo idioma que eligió el servidor. Textos y formato de números y fechas salen de aquí.
  const t = dict(document.documentElement.lang);
  const L = t.locale;

  function byId<T extends HTMLElement = HTMLElement>(id: string): T {
    const el = document.getElementById(id);
    if (!el) throw new Error('Falta #' + id);
    return el as T;
  }
  function part<T extends HTMLElement = HTMLElement>(root: ParentNode, selector: string): T {
    const el = root.querySelector(selector);
    if (!el) throw new Error('Falta ' + selector);
    return el as T;
  }
  function fromTemplate(id: string): HTMLElement {
    const el = byId<HTMLTemplateElement>(id).content.firstElementChild;
    if (!el) throw new Error('Plantilla vacía #' + id);
    return el.cloneNode(true) as HTMLElement;
  }
  function emptyState(text: string): HTMLElement {
    const e = document.createElement('div');
    e.className = emptyStateClass;
    e.textContent = text;
    return e;
  }

  const rowsEl = byId('rows');
  const pctEl = byId<HTMLInputElement>('pct');
  const noteEl = byId('note');
  const histEl = byId('histList');
  const histNote = byId('histNote');
  const histName = byId<HTMLInputElement>('histName');
  const pdfNote = byId('pdfNote');
  const TONES = ['lavender', 'mint', 'peach', 'sun'];

  const state = loadState(t.table.examples);
  const history = loadHistory();
  let outs: { total: HTMLElement; disc: HTMLElement }[] = [];

  // Solo se llama tras una acción de la persona, así que también marca el primer uso.
  function save() {
    saveState(state);
    trackFirstUse();
  }

  function totals() {
    const s = summarize(state.items, state.pct);
    state.items.forEach((it, i) => {
      outs[i].total.textContent = money(itemTotal(it), L);
      outs[i].disc.textContent = money(itemDiscounted(it, state.pct), L);
    });
    byId('sumTotal').textContent = money(s.total, L);
    byId('sumDisc').textContent = money(s.pay, L);
    byId('pay').textContent = money(s.pay, L);
    byId('gain').textContent = money(s.gain, L);
    byId('count').textContent = t.table.countLabel(s.active, s.count);
    byId('pctEcho').textContent = num(clampPct(state.pct), L);
    noteEl.textContent = state.examples ? t.table.examplesNote : '';
  }

  function edited() {
    state.examples = false;
    save();
    totals();
  }

  function numInput(row: HTMLElement, field: 'price' | 'qty', it: Item, i: number, label: string) {
    const el = part<HTMLInputElement>(row, `[data-f="${field}"]`);
    el.id = field + '-' + i;
    el.value = it[field] === '' || it[field] == null ? '' : String(it[field]);
    el.setAttribute('aria-label', label);
    el.addEventListener('input', () => {
      it[field] = el.value;
      edited();
    });
    el.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter') {
        ev.preventDefault();
        add();
      }
    });
  }

  function render() {
    rowsEl.replaceChildren();
    outs = [];
    if (!state.items.length) rowsEl.append(emptyState(t.table.empty));
    state.items.forEach((it, i) => {
      const n = i + 1;
      const row = fromTemplate('row-tpl');
      row.toggleAttribute('data-off', !isActive(it));

      const tog = part<HTMLInputElement>(row, '[data-f="on"]');
      tog.id = 'on-' + i;
      tog.checked = isActive(it);
      tog.setAttribute('aria-label', t.table.toggleAria(n));
      tog.addEventListener('change', () => {
        it.on = tog.checked;
        row.toggleAttribute('data-off', !tog.checked);
        edited();
      });

      const name = part<HTMLInputElement>(row, '[data-f="name"]');
      name.id = 'name-' + i;
      name.value = it.name || '';
      name.setAttribute('aria-label', t.table.nameAria(n));
      name.addEventListener('input', () => {
        it.name = name.value;
        edited();
      });

      numInput(row, 'price', it, i, t.table.priceAria(n));
      numInput(row, 'qty', it, i, t.table.qtyAria(n));

      const del = part(row, '[data-f="del"]');
      del.setAttribute('aria-label', t.table.deleteAria(n));
      del.addEventListener('click', () => {
        state.items.splice(i, 1);
        state.examples = false;
        save();
        render();
      });

      outs.push({ total: part(row, '[data-out="total"]'), disc: part(row, '[data-out="disc"]') });
      rowsEl.append(row);
    });
    totals();
  }

  function add() {
    state.items.push({ name: '', price: '', qty: 1 });
    state.examples = false;
    save();
    render();
    document.getElementById('name-' + (state.items.length - 1))?.focus();
  }

  byId('add').addEventListener('click', add);
  byId('clear').addEventListener('click', () => {
    state.items = [];
    state.examples = false;
    save();
    render();
  });
  // Al hacer clic o tabular al porcentaje queda todo seleccionado, listo para reemplazar.
  // Con el ratón, el mousedown mueve el cursor después del foco: se vuelve a seleccionar en el
  // mouseup y se cancela su acción por defecto para que no deshaga la selección (Safari).
  let selectOnMouseUp = false;
  pctEl.addEventListener('focus', () => {
    pctEl.select();
    selectOnMouseUp = true;
  });
  pctEl.addEventListener('mouseup', (ev) => {
    if (!selectOnMouseUp) return;
    selectOnMouseUp = false;
    ev.preventDefault();
    pctEl.select();
  });
  pctEl.addEventListener('input', () => {
    // Fuera de 0–MAX_PCT el campo se corrige al instante para que muestre lo que se calcula.
    const typed = parseFloat(pctEl.value);
    if (typed > MAX_PCT || typed < 0) pctEl.value = String(clampPct(typed));
    state.pct = pctEl.value;
    save();
    totals();
  });

  // Selector de idioma: al tocar (móvil) o con Enter se abre y cierra; se cierra al tocar fuera, con Escape
  // o cuando el foco sale del selector.
  // Con ratón también se abre al pasar por encima (CSS, ver Header.astro).
  const langBox = byId('lang');
  const langBtn = byId<HTMLButtonElement>('lang-btn');
  function setLangOpen(open: boolean) {
    langBox.toggleAttribute('data-open', open);
    langBtn.setAttribute('aria-expanded', String(open));
  }
  langBtn.addEventListener('click', () => setLangOpen(!langBox.hasAttribute('data-open')));
  document.addEventListener('click', (ev) => {
    if (!langBox.contains(ev.target as Node)) setLangOpen(false);
  });
  langBox.addEventListener('focusout', (ev) => {
    if (!langBox.contains(ev.relatedTarget as Node | null)) setLangOpen(false);
  });
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && langBox.hasAttribute('data-open')) {
      setLangOpen(false);
      langBtn.focus();
    }
  });

  // Historial
  function renderHistory() {
    histEl.replaceChildren();
    if (!history.length) {
      histEl.append(emptyState(t.history.empty));
      return;
    }
    history.forEach((h, i) => {
      const s = summarize(h.items, h.pct);
      const entry = fromTemplate('hist-tpl');
      part(entry, '[data-h="icon"]').dataset.tone = TONES[i % TONES.length];
      part(entry, '[data-h="name"]').textContent = h.name;
      part(entry, '[data-h="meta"]').textContent = t.history.meta({
        when: new Date(h.at).toLocaleString(L, { dateStyle: 'medium', timeStyle: 'short' }),
        count: h.items.length,
        total: money(s.total, L),
        pct: num(clampPct(h.pct), L),
        pay: money(s.pay, L),
        gain: money(s.gain, L),
      });

      part(entry, '[data-h="load"]').addEventListener('click', () => {
        state.items = structuredClone(h.items);
        state.pct = h.pct;
        state.examples = false;
        pctEl.value = String(state.pct);
        histName.value = h.name;
        save();
        render();
        histNote.textContent = t.history.loaded(h.name);
      });
      const del = part(entry, '[data-h="del"]');
      del.setAttribute('aria-label', t.history.deleteAria(h.name));
      del.addEventListener('click', () => {
        history.splice(i, 1);
        saveHistory(history);
        renderHistory();
        histNote.textContent = t.history.hint;
      });
      histEl.append(entry);
    });
  }

  byId('histSave').addEventListener('click', () => {
    if (!state.items.length) {
      histNote.textContent = t.history.emptyList;
      return;
    }
    const now = new Date();
    const name = histName.value.trim() || t.history.defaultName(now.toLocaleDateString(L, { dateStyle: 'medium' }));
    history.unshift({ name, at: now.getTime(), pct: clampPct(state.pct), items: structuredClone(state.items) });
    if (saveHistory(history)) {
      track('Guardó en historial');
      histNote.textContent = t.history.saved(name);
      histName.value = '';
    } else {
      history.shift();
      histNote.textContent = t.history.blocked;
    }
    renderHistory();
  });

  // PDF
  function say(msg: string) {
    pdfNote.textContent = msg;
    pdfNote.hidden = !msg;
  }

  byId('pdf').addEventListener('click', async () => {
    if (!state.items.some(isActive)) {
      say(t.pdf.noActive);
      return;
    }
    say(t.pdf.preparing);
    let JsPDF: Awaited<ReturnType<typeof loadJsPDF>>;
    try {
      JsPDF = await loadJsPDF();
    } catch {
      say(t.pdf.loadFailed);
      return;
    }
    const title = histName.value.trim() || t.pdf.defaultTitle;
    const now = new Date();
    let data: ArrayBuffer;
    try {
      data = buildPdf(JsPDF, t, title, state.items, state.pct, now);
    } catch {
      say(t.pdf.buildFailed);
      return;
    }
    const sent = downloadPdf(pdfFilename(title, now, t.pdf.fileFallback), data);
    if (sent) track('Descargó PDF');
    say(sent ? t.pdf.sent : t.pdf.blocked);
  });

  pctEl.value = String(state.pct);
  render();
  renderHistory();
</script>
