---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '../styles/global.css';
import { dict, LANGS } from '../i18n';
import { ORIGINS, UMAMI_ID } from '../lib/site';

// <html lang> sigue el idioma de la interfaz; los metadatos siguen el dominio (src/middleware.ts):
// el dominio de SITE_URL_ES comparte en español y el de SITE_URL_EN en inglés.
const lang = Astro.locals.lang;
const seoLang = Astro.locals.seoLang;
const t = dict(seoLang);
const origin = ORIGINS[seoLang];
const otherLocales = LANGS.filter((l) => l !== seoLang).map((l) => dict(l).ogLocale);
// Las dos imágenes (public/ogimage.jpg y public/ogimage-en.jpg) miden lo mismo; si cambian, actualizar aquí.
const IMAGE_SIZE = { width: 1672, height: 941 };

const path = Astro.url.pathname;
const canonical = new URL(path, origin).href;
const imageUrl = new URL(t.seo.image, origin).href;
const umamiDomains = LANGS.map((l) => new URL(ORIGINS[l]).hostname).join(',');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.seo.title}</title>
    <meta name="description" content={t.seo.description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(path, ORIGINS[l]).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, ORIGINS.en).href} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Mauro Hernández" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#eef0fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mahebo" />
    <meta property="og:locale" content={t.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.seo.ogTitle} />
    <meta property="og:description" content={t.seo.description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={t.seo.imageAlt} />

    {/* X / Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.seo.ogTitle} />
    <meta name="twitter:description" content={t.seo.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={t.seo.imageAlt} />

    {
      import.meta.env.PROD && UMAMI_ID && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={UMAMI_ID}
          data-domains={umamiDomains}
        />
      )
    }

    <slot name="head" />
  </head>
  <body class="min-h-dvh px-4 pt-7 pb-12 text-[15px] leading-[1.45] text-ink sm:pt-10">
    <slot />
  </body>
</html>
