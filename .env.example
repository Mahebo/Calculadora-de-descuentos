# Copia este archivo como .env y ajusta los valores. En producción (Coolify u otro),
# defínelos como variables de entorno del servidor: se leen al arrancar, no al compilar.

# Dominio de cada idioma, con https:// y sin barra final.
# Los metadatos (title, description, Open Graph, canonical), robots.txt y sitemap.xml salen del dominio.
SITE_URL_ES=https://calculadora.example.com
SITE_URL_EN=https://calculator.example.com

# ID del sitio en Umami (opcional). Sin valor, la página no carga la analítica.
UMAMI_WEBSITE_ID=
